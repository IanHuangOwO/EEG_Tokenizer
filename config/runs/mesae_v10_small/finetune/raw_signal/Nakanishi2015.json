{
  "base_config": "config/runs/mesae_v10_small/pretrain.json",
  "dataset_params": {
    "finetune": {
      "Nakanishi2015": {
        "dataset_path": "datas/finetune/Nakanishi2015",
        "subject_to_use": [
          "all"
        ],
        "channels_to_use": [
          "all"
        ]
      }
    }
  },
  "model_params": {
    "MeSAE": {
      "finetune": {
        "features": [
          "raw_signal"
        ],
        "spatial_k": 8,
        "time_pool": "none",
        "dropout": 0.5
      }
    }
  },
  "training_params": {
    "finetune": {
      "model_type": "MeSAE",
      "model_name": "mesae_v10_small/finetune/raw_signal/Nakanishi2015_intra",
      "pretrained_checkpoint": "output/mesae_v10_small/pretrain/checkpoint/last.pth",
      "learning_rate": 0.01,
      "min_learning_rate": 0.001,
      "epochs": 100,
      "warmup_epochs": 2,
      "batch_size": 16,
      "weight_decay": 0.01,
      "device": "cuda",
      "split": {
        "mode": "intra_subject",
        "n_folds": 5
      }
    },
    "visualize_params": {
      "finetune": {
        "every_n_epochs": 10
      }
    }
  }
}
