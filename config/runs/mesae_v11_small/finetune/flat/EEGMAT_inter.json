{
  "base_config": "config/runs/mesae_v11_small/pretrain.json",
  "dataset_params": {
    "finetune": {
      "EEGMAT": {
        "dataset_path": "datas/finetune/EEGMAT",
        "subject_to_use": [
          "all"
        ],
        "channels_to_use": [
          "all"
        ]
      }
    }
  },
  "model_params": {
    "MeSAE": {
      "finetune": {
        "features": [
          "stamp_power"
        ],
        "spatial_k": 8,
        "time_pool": "flat",
        "dropout": 0.5
      }
    }
  },
  "training_params": {
    "finetune": {
      "model_type": "MeSAE",
      "model_name": "flat_EEGMAT_inter",
      "pretrained_checkpoint": "output/mesae_v11_small/checkpoint/last.pth",
      "learning_rate": 0.01,
      "min_learning_rate": 0.001,
      "epochs": 100,
      "warmup_epochs": 2,
      "batch_size": 16,
      "weight_decay": 0.01,
      "device": "cuda",
      "split": {
        "mode": "inter_subject",
        "n_folds": 36
      },
      "output_path": "mesae_v11_small/finetune/flat/EEGMAT_inter"
    },
    "visualize_params": {
      "finetune": {
        "every_n_epochs": 10
      }
    }
  }
}