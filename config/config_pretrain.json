{
  "model_params": {
    "MeFSQ": {
      "pretrain": {
        "patch_len": 100,
        "embed_dim": 128,
        "enc_depth": 8,
        "enc_heads": 8,
        "mlp_ratio": 4.0,
        "spatial_heads": 8,
        "stage_indices": [0, 1, 3, 7],
        "vq_head_num": 64,
        "vq_head_vocab_size": 16,
        "vq_num_discrete": 5
      }
    }
  },
  "preprocess_params": {
    "trial_length": 800,
    "trial_pad_threshold": 0.5,
    "patch_length": 100,
    "target_freq": 200,
    "l_freq": 0.2,
    "h_freq": 75.0,
    "normalization_type": "zscore",
    "masking_strategy": "complementary",
    "random": {
      "mask_ratio": 0.3
    },
    "complementary": {},
    "block": {
      "mask_ratio": 0.3,
      "mask_row_prob": 0.4,
      "mask_col_prob": 0.4
    }
  },
  "dataset_params": {
    "BETA_3s": {
      "dataset_path": "datas/BETA_3s",
      "subject_to_use": [
        "all"
      ],
      "channels_to_use": [
        "all"
      ]
    },
    "BETA_4s": {
      "dataset_path": "datas/BETA_4s",
      "subject_to_use": [
        "all"
      ],
      "channels_to_use": [
        "all"
      ]
    }
  },
  "training_params": {
    "model_type": "MeFSQ",
    "model_name": "mefsq_pretrain_v0",
    "learning_rate": 0.001,
    "min_learning_rate": 0.0001,
    "epochs": 100,
    "warmup_epochs": 10,
    "batch_size": 32,
    "weight_decay": 0.0001,
    "device": "cuda",
    "train_val_split": 0.9,
    "vq_warmup_epochs": 10
  },
  "loss_params": {
    "mask_weight": 1.0
  },
  "metrics_params": {}
