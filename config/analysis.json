{
  "checkpoint": "output/mesae_tokenizer_v2/tokenizer/best_tokenizer.pth",
  "mode": "tokenizer",

  "dataset_params": {
    "pretrain": {
      "BETA_3s": {
        "dataset_path": "datas/BETA_3s",
        "subject_to_use": ["1"],
        "channels_to_use": ["all"]
      },
      "BCICIV1_Train": {
        "dataset_path": "datas/BCICIV1_Train",
        "subject_to_use": ["1"],
        "channels_to_use": ["all"]
      },
      "Inria_Train": {
        "dataset_path": "datas/Inria_Train",
        "subject_to_use": ["2"],
        "channels_to_use": ["all"]
      },
      "EEGMMIdb": {
        "dataset_path": "datas/EEGMMIdb",
        "subject_to_use": ["1"],
        "channels_to_use": ["all"]
      }
    }
  },

  "check": {
    "analysis": "codebook",
    "plot_recon":     true,
    "plot_topo_psd":  true,
    "plot_attn_topo": true,
    "cmap": "YlOrRd",
    "codebook": {
      "max_trials_per_dataset": 200
    }
  }
}
