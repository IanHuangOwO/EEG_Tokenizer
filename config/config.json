{
  "model_params": {
    "MeFSQ": {
      "pretrain": {
        "patch_len": 20,
        "embed_dim": 100,
        "enc_depth": 12,
        "spatial_heads": 10,
        "mlp_ratio": 4.0,
        "moe": {
          "n_routed_experts": 128,
          "top_k": 32,
          "n_shared_experts": 4,
          "routed_expert": { "r": 8, "num_discrete": 3, "decoder_hidden": 100 },
          "shared_expert": { "r": 16, "num_discrete": 5, "decoder_hidden": 100 }
        },
        "dropout": 0.3,
        "pool_after_blocks": [2, 5, 8, 11],
        "upsample_residual_add": true,
        "loss": {
          "mask_weight": 1.0,
          "load_balance_weight": 0.01
        }
      },
      "finetune": {
        "hidden": 100,
        "freeze_backbone": true,
        "dropout": 0.3
      }
    },
    "MeSAE": {
      "pretrain": {
        "patch_len": 20,
        "embed_dim": 50,
        "enc_depth": 12,
        "spatial_heads": 10,
        "mlp_ratio": 4.0,
        "dropout": 0.3,
        "pool_after_blocks": [2, 5, 8, 11],
        "upsample_residual_add": true,
        "sae": {
          "n_filters": 16,
          "pool_hidden": 32,
          "pool_temperature": 4.0,
          "sae_expansion": 4,
          "sae_k": 32,
          "decoder_hidden": 100
        },
        "loss": {
          "aux_weight": 0.03,
          "mask_weight": 1.0
        }
      },
      "finetune": {
        "hidden": 100,
        "freeze_backbone": true,
        "dropout": 0.3
      }
    }
  },
  "preprocess_params": {
    "canonical_channels": [
      "Fp1", "Fpz", "Fp2",
      "AF7", "AF3", "AFz", "AF4", "AF8",
      "F7",  "F5",  "F3",  "F1",  "Fz",  "F2",  "F4",  "F6",  "F8",
      "FT7", "FC5", "FC3", "FC1", "FCz", "FC2", "FC4", "FC6", "FT8",
      "T7",  "C5",  "C3",  "C1",  "Cz",  "C2",  "C4",  "C6",  "T8",
      "TP7", "CP5", "CP3", "CP1", "CPz", "CP2", "CP4", "CP6", "TP8",
      "P9",  "P7",  "P5",  "P3",  "P1",  "Pz",  "P2",  "P4",  "P6",  "P8",  "P10",
      "PO7", "PO3", "POz", "PO4", "PO8",
      "O1",  "Oz",  "O2",  "Iz"
