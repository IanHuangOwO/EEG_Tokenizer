{
  "model_params": {
    "MeFSQ": {
      "pretrain": {
        "patch_len": 20,
        "embed_dim": 100,
        "enc_depth": 12,
        "spatial_heads": 10,
        "mlp_ratio": 4.0,
        "moe": {
          "n_routed_experts": 64,
          "top_k": 16,
          "n_shared_experts": 2,
          "routed_expert": { "r": 16, "num_discrete": 3, "decoder_hidden": null },
          "shared_expert": { "r": 64, "num_discrete": 5, "decoder_hidden": null }
        },
        "dropout": 0.3,
        "pool_after_blocks": [2, 5, 8, 11],
        "upsample_residual_add": true
      },
      "finetune": {
        "hidden": 100,
        "freeze_backbone": true,
        "dropout": 0.3
      }
    }
  },
  "preprocess_params": {
    "canonical_channels": [
      "Fp1", "Fpz", "Fp2",
      "AF7", "AF3", "AFz", "AF4", "AF8",
      "F7",  "F5",  "F3",  "F1",  "Fz",  "F2",  "F4",  "F6",  "F8",
      "FT7", "FC5", "FC3", "FC1", "FCz", "FC2", "FC4", "FC6", "FT8",
      "T7",  "C5",  "C3",  "C1",  "Cz",  "C2",  "C4",  "C6",  "T8",
      "TP7", "CP5", "CP3", "CP1", "CPz", "CP2", "CP4", "CP6", "TP8",
      "P9",  "P7",  "P5",  "P3",  "P1",  "Pz",  "P2",  "P4",  "P6",  "P8",  "P10",
      "PO7", "PO3", "POz", "PO4", "PO8",
      "O1",  "Oz",  "O2",  "Iz"
    ],
    "trial_length": 800,
    "trial_pad_threshold": 0.5,
    "patch_length": 20,
    "target_freq": 200,
    "l_freq": 0.2,
    "h_freq": 75.0,
    "normalization_type": "zscore",
    "masking_strategy": "complementary",
    "random": {
      "mask_ratio": 0.3
    },
    "complementary": {}
  },
  "dataset_params": {
    "pretrain": {
      "BETA_3s": {
        "dataset_path": "datas/BETA_3s",
        "subject_to_use": ["all"],
        "channels_to_use": ["all"]
      },
      "BETA_4s": {
        "dataset_path": "datas/BETA_4s",
        "subject_to_use": ["all"],
        "channels_to_use": ["all"]
      },
      "EEGMMIdb": {
        "dataset_path": "datas/EEGMMIdb",
        "subject_to_use": ["all"],
        "channels_to_use": ["all"]
      },
      "Inria_Train": {
        "dataset_path": "datas/Inria_Train",
        "subject_to_use": ["all"],
        "channels_to_use": ["all"]
      }
    },
    "finetune": {
      "BCICIV2a": {
        "dataset_path": "datas/BCICIV2a",
        "subject_to_use": ["all"],
        "channels_to_use": ["all"]
      }
    }
  },
  "training_params": {
    "pretrain": {
      "model_type": "MeFSQ",
      "model_name": "mefsq_pretrain_v1",
      "learning_rate": 0.001,
      "min_learning_rate": 0.0001,
      "epochs": 50,
      "warmup_epochs": 5,
      "vq_warmup_epochs": 10,
      "batch_size": 16,
      "weight_decay": 0.05,
      "device": "cuda",
      "train_val_split": 0.9
    },
    "finetune": {
      "model_type": "MeFSQ",
      "model_name": "mefsq_finetune_v4",
      "pretrained_checkpoint": "output/mefsq_pretrain_v1/pretrain/best_pretrain.pth",
      "learning_rate": 0.0005,
      "min_learning_rate": 0.00001,
      "backbone_lr_mult": 0.02,
      "epochs": 50,
      "warmup_epochs": 10,
      "batch_size": 16,
      "weight_decay": 0.05,
      "device": "cuda",
      "train_val_split": 0.8,
      "split_mode": "subject"
    }
  },
  "loss_params": {
    "pretrain": {
      "mask_weight": 1.0,
      "load_balance_weight": 0.01
    }
  }
}
