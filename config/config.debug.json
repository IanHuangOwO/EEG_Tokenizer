          "mlp_ratio": 4.0,
          "n_routed_experts": 4,
          "n_shared_experts": 1,
          "top_k": 2,
          "expert_hidden": null
        },
        "stamp_bank": {
          "n_stamps": 800,
          "n_shared_stamps": 4,
          "stamp_top_k": 16,
          "stamp_hidden_width": 16,
          "stamp_shared_hidden_width": 32,
          "dead_threshold_frac": 0.1,
          "aux_k_cap_frac": 0.1,
          "sae_ema_decay": 0.99
