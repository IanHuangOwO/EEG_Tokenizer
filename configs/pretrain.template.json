  "preprocess_params": {
    "canonical_channels": "10-10",
    "window_length": 1000,
    "patch_length": 50,
    "patch_stride": 25,
    "sample_freq": 200,
    "bandpass_filter": {
      "l_freq": 0.5,
      "h_freq": 100.0
    },
    "pre_event_seconds": 1.0,
    "post_event_seconds": 4.0,
    "normalization_type": "zscore",
    "mask": {
      "masking_strategy": "mixture",
      "time_run": 3,
      "random": {
        "mask_ratio": 0.3
      },
      "mixture": {
        "start_ratio": 0.1,
        "ramp_epochs": 10,
        "modes": [
          {
            "type": "channel_cluster",
            "prob": 0.35,
            "max_ratio": 0.2,
            "radius_cm": [
              3.0,
              7.0
            ]
          },
          {
            "type": "random_channel",
            "prob": 0.35,
            "max_ratio": 0.3
          },
          {
            "type": "time_block",
            "prob": 0.3,
            "max_ratio": 0.4,
            "run_patches": [
              3,
              8
            ]
          }
        ]
      },
      "subsample": {
        "enabled": true,
        "montages": [
          "motor-3",
          "p300-8",
          "motor-13",
          "p300-16",
          "10-20",
          "bci-22"
        ],
        "prob": 0.2,
        "start_epoch": 11,
        "ramp_epochs": 10,
        "dense_min_channels": 32,
        "min_keep": 3
      }
    }
  },
  "model_params": {
    "MeSAE": {
      "pretrain": {
        "patch_len": 50,
        "embed_dim": 100,
        "enc_depth": 8,
        "spatial_heads": 5,
        "dropout": 0.3,
        "sample_freq": 200,
        "patch_stride": 25,
        "moe_ffn": {
          "mlp_ratio": 4.0,
          "n_routed_experts": 4,
          "n_shared_experts": 1,
          "top_k": 2
        },
        "stamp_bank": {
          "n_routed_stamps": 0,
          "n_shared_stamps": 16,
          "stamp_top_k": 0,
          "stamp_hidden_width": 6,
          "stamp_shared_hidden_width": 8,
          "dead_threshold_frac": 0.1,
          "aux_k_cap_frac": null,
          "sae_ema_decay": 0.99,
          "selection_mode": "topk"
        },
        "loss": {
          "mse_patch_weight": 1.0,
          "mse_trial_weight": 1.0,
          "unmasked_weight": 0.1,
          "ffn_lb_weight": 0.01,
          "aux_weight": 0.0,
          "mp_weight": 1.0
        },
        "spatial_embedding": true,
        "blocks_per_stage": 2,
        "skip_mode": "gated",
        "decoder_blocks": 0
      }
    }
  },
  "training_params": {
    "pretrain": {
      "model_type": "MeSAE",
      "model_name": "mesae_vXX_small",
      "tokenizer_epochs": 10,
      "freeze_stamps": false,
      "learning_rate": 0.001,
      "min_learning_rate": 0.0001,
      "epochs": 50,
      "warmup_epochs": 5,
