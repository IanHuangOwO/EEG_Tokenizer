{
  "base_config": "configs/pretrain.template.json",
  "dataset_params": {
    "finetune": {
      "BNCI2014001": {
        "dataset_path": "datas/finetune/BNCI2014001",
        "subject_to_use": [
          "all"
        ],
        "channels_to_use": [
          "all"
        ]
      }
    }
  },
  "model_params": {
    "MeSAE": {
      "finetune": {
        "_comment": "Modular head (MeSAE_modules FeatureHead): each features entry is {type, its own keys} and gets its own spatial filter. Types: stamp_power / stamp_band (log power, time_pool flat|learned|window|none, time_rank, window), signed_ab (signed phase-locked: stamp_rank, time_rank), evoked (evoked_rank), phase_advance, raw_band, raw_signal. Any entry may set its own spatial_k (default below).",
        "spatial_k": 8,
        "dropout": 0.5,
        "features": [
          {
            "type": "stamp_power",
            "time_pool": "learned",
            "time_rank": 2
          }
        ]
      }
    }
  },
  "training_params": {
    "finetune": {
      "model_type": "MeSAE",
      "model_name": "learned_BNCI2014001_intra",
      "pretrained_checkpoint": "output/mesae_vXX_small/pretrain/checkpoint/last.pth",
      "learning_rate": 0.01,
      "min_learning_rate": 0.001,
      "epochs": 100,
      "warmup_epochs": 2,
      "batch_size": 16,
      "weight_decay": 0.01,
      "device": "cuda",
      "split": {
        "mode": "intra_subject",
        "n_folds": 5
      },
      "output_path": "mesae_vXX_small/finetune/learned/BNCI2014001_intra",
      "class_weight": null
    },
    "visualize_params": {
      "finetune": {
        "every_n_epochs": 10
      }
    }
  }
}