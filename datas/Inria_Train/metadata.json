        "dataset_name": "Inria_Train",
        "dataset_info": {
            "source_url": "https://www.kaggle.com/c/inria-bci-challenge",
            "file_format": "CSV",
            "description": "P300-speller feedback recordings used to detect error-related potentials (ErrP): whether the subject perceived the speller's feedback (letter selection) as erroneous.",
            "task_type": "error_related_potential",
            "reference": "Margaux, P., Emmanuel, M., Sebastien, D., Olivier, B., & Jeremie, M. (2012). Objective and subjective evaluation of online error correction during P300-based spelling. Advances in Human-Computer Interaction.",
            "notes": "56 EEG channels (10-20/10-10) + 1 EOG channel, sampled at 200 Hz (inferred from the Time column's 0.005s step). Each subject has 5 sessions; trials are cut as a 1.3s window starting at each FeedBackEvent marker, a commonly used feedback-locked epoch length for this challenge. Channel 54 is labelled 'P08' in the raw files (typo for PO8, preserved via original_label)."
        },
        "acquisition": {
            "sample_frequency": 200,
            "window_size_seconds": 1.3,
            "num_subjects": 16,
            "num_sessions_per_subject": 5
        },
